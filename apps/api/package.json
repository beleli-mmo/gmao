{
  "name": "@gmao/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ingest": "tsx watch src/sync/couch-ingest.worker.ts",
    "prod:build": "prisma generate && prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "couch:setup": "tsx scripts/couch-setup.ts",
    "start": "tsx src/server.ts",
    "start:ingest": "tsx src/sync/couch-ingest.worker.ts",
    "prisma:studio": "prisma studio",
    "db:local:generate": "prisma generate --schema prisma/schema.dev.prisma",
    "db:local:push": "prisma db push --schema prisma/schema.dev.prisma --accept-data-loss",
    "db:local:studio": "prisma studio --schema prisma/schema.dev.prisma",
    "db:local:setup": "npm run db:local:generate && npm run db:local:push && npm run db:seed"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@gmao/shared": "*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nano": "^10.1.4",
    "prisma": "^5.22.0",
    "tsx": "^4.16.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.0"
  }
}
