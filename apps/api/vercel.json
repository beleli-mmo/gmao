{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --workspaces --include-workspace-root",
  "buildCommand": "prisma generate",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 30, "memory": 512 }
  }
}
