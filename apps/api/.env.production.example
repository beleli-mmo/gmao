# ── API GMAO — production ────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# PostgreSQL Neon
#   DATABASE_URL = URL "pooled"  (host contient "-pooler", suffixe ?sslmode=require)
#   DIRECT_URL   = URL directe   (sans "-pooler") — utilisée par prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/gmao?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/gmao?sslmode=require"

# Secrets JWT — générer :  openssl rand -hex 32
JWT_ACCESS_SECRET="__CHANGE_MOI__"
JWT_REFRESH_SECRET="__CHANGE_MOI__"

# Origines autorisées (front admin + PWA), séparées par des virgules
CORS_ORIGINS="https://gmao-admin.vercel.app,https://gmao-terrain.vercel.app"

# Barèmes analytiques
DEFAULT_LABOR_RATE=12000
TRAVEL_KM_RATE=350

# ── Stockage des pièces jointes (S3-compatible, ex. Cloudflare R2) ───
# Facultatif : sans ces variables, les DI se synchronisent mais les photos
# ne sont pas conservées côté serveur.
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="gmao-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ── (Variante CouchDB, non requise pour le déploiement Vercel/REST) ──
# COUCH_URL="https://admin:pass@host:5984"
# COUCH_FIELD_DB="field-tickets"
# COUCH_META_DB="sync-meta"
